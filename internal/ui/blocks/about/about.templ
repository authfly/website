package about

import (
	templpkg "github.com/a-h/templ"
	"github.com/authfly/website/internal/kit/ui/block"
	"github.com/authfly/website/internal/kit/ui/box"
	"github.com/authfly/website/internal/kit/ui/grid"
	"github.com/authfly/website/internal/kit/ui/group"
	"github.com/authfly/website/internal/kit/ui/image"
	"github.com/authfly/website/internal/kit/ui/inline"
	"github.com/authfly/website/internal/kit/ui/link"
	"github.com/authfly/website/internal/kit/ui/list"
	"github.com/authfly/website/internal/kit/ui/stack"
	"github.com/authfly/website/internal/kit/ui/text"
	"github.com/authfly/website/internal/kit/ui/title"
	"github.com/authfly/website/internal/viewmodels"
)

templ Page(m viewmodels.AboutModel) {
	@block.Block(block.BlockProps{Tag: "article", Class: "space-y-12"}) {
		@grid.Grid(grid.GridProps{Class: "items-start gap-10 lg:grid-cols-[1.4fr_1fr]"}) {
			@stack.Stack(stack.StackProps{Class: "gap-5"}) {
				@block.Block(block.BlockProps{Tag: "header", Class: "space-y-4"}) {
					@title.Title(title.TitleProps{As: 1, Class: "font-display text-display-2 font-bold"}) {
						{ m.Page.Title }
					}
					@text.Text(text.TextProps{Class: "text-lead text-muted-foreground"}) {
						{ m.Page.Lead }
					}
				}
				for _, para := range m.Page.Body {
					@text.Text(text.TextProps{Class: "text-base leading-8 text-foreground/90"}) {
						{ para }
					}
				}
			}
			@stack.Stack(stack.StackProps{Class: "gap-4"}) {
				if m.Page.Portrait.Src != "" {
					@box.Box(box.BoxProps{
						Class: "overflow-hidden rounded-2xl border border-border bg-card shadow-lift",
						Attrs: templpkg.Attributes{"aria-label": m.Page.Portrait.Aria},
					}) {
						@image.Image(image.ImageProps{
							Src:     m.Page.Portrait.Src,
							Alt:     m.Page.Portrait.Aria,
							Class:   "aspect-[4/5] w-full object-cover object-top",
							Loading: "lazy",
						})
					}
				}
				if len(m.Page.Meta) > 0 {
					@stack.Stack(stack.StackProps{Class: "gap-1 text-sm text-muted-foreground"}) {
						for _, line := range m.Page.Meta {
							@text.Text(text.TextProps{}) {
								{ line }
							}
						}
					}
				}
			}
		}
		if len(m.Page.Pillars) > 0 {
			@block.Block(block.BlockProps{Tag: "section", Class: "space-y-4"}) {
				@title.Title(title.TitleProps{As: 2, Class: "font-display text-display-3 font-bold"}) {
					if m.Page.PillarsTitle != "" {
						{ m.Page.PillarsTitle }
					} else {
						{ m.Layout.Copy.About.PillarsTitle }
					}
				}
				@list.List(list.ListProps{Tag: "ul", Class: "list-disc space-y-2 pl-5 text-muted-foreground"}) {
					for _, item := range m.Page.Pillars {
						@list.ListItem(list.ListItemProps{}) {
							{ item }
						}
					}
				}
			}
		}
		if len(m.Page.Books) > 0 {
			@block.Block(block.BlockProps{Tag: "section", Class: "space-y-6"}) {
				@stack.Stack(stack.StackProps{Class: "gap-2"}) {
					if m.Page.BooksEyebrow != "" {
						@inline.Inline(inline.InlineProps{Class: "text-xs font-semibold uppercase tracking-label text-muted-foreground"}) {
							{ m.Page.BooksEyebrow }
						}
					}
					@title.Title(title.TitleProps{As: 2, Class: "font-display text-display-3 font-bold"}) {
						{ m.Page.BooksTitle }
					}
					if m.Page.BooksIntro != "" {
						@text.Text(text.TextProps{Class: "max-w-3xl text-muted-foreground"}) {
							{ m.Page.BooksIntro }
						}
					}
				}
				@grid.Grid(grid.GridProps{Class: "gap-4 md:grid-cols-2"}) {
					for _, book := range m.Page.Books {
						@box.Box(box.BoxProps{Class: "rounded-2xl border border-border bg-card p-5 shadow-lift"}) {
							@stack.Stack(stack.StackProps{Class: "gap-3"}) {
								@title.Title(title.TitleProps{As: 3, Class: "font-display text-lg font-semibold"}) {
									{ book.Title }
								}
								@group.Group(group.GroupProps{Class: "flex-wrap gap-2 text-xs text-muted-foreground"}) {
									@inline.Inline(inline.InlineProps{}) {
										{ book.Publisher }
									}
									@inline.Inline(inline.InlineProps{}) {
										·
									}
									@inline.Inline(inline.InlineProps{}) {
										{ book.Year }
									}
									if book.Pages > 0 {
										@inline.Inline(inline.InlineProps{}) {
											·
										}
										@inline.Inline(inline.InlineProps{Class: "numeric"}) {
											{ viewmodels.Itoa(book.Pages) }
										}
									}
								}
								@text.Text(text.TextProps{Class: "text-sm leading-6 text-muted-foreground"}) {
									{ book.Desc }
								}
								if book.Href != "" {
									@link.Link(link.LinkProps{
										Href:  book.Href,
										Class: "inline-flex w-fit text-sm font-semibold text-primary no-underline hover:underline",
									}) {
										if book.CTA != "" {
											{ book.CTA }
										} else {
											{ m.Layout.Copy.Common.ReadMore }
										}
									}
								}
							}
						}
					}
				}
			}
		}
		if len(m.Page.Timeline) > 0 {
			@block.Block(block.BlockProps{Tag: "section", Class: "space-y-6"}) {
				@title.Title(title.TitleProps{As: 2, Class: "font-display text-display-3 font-bold"}) {
					{ m.Page.TimelineTitle }
				}
				@stack.Stack(stack.StackProps{Class: "gap-3"}) {
					for i, step := range m.Page.Timeline {
						@box.Box(box.BoxProps{
							Class: "rounded-2xl border border-border bg-card p-4 shadow-lift animate-rise stagger",
							Attrs: templpkg.Attributes{"style": "--stagger-index: " + viewmodels.Itoa(i)},
						}) {
							@inline.Inline(inline.InlineProps{Class: "text-xs font-semibold uppercase tracking-label text-primary"}) {
								{ step.Period }
							}
							@title.Title(title.TitleProps{As: 3, Class: "mt-1 text-base font-semibold"}) {
								{ step.Label }
							}
							@text.Text(text.TextProps{Class: "mt-1 text-sm leading-6 text-muted-foreground"}) {
								{ step.Detail }
							}
						}
					}
				}
			}
		}
	}
}
