package blog

import (
	"github.com/authfly/website/internal/kit/ui/badge"
	"github.com/authfly/website/internal/kit/ui/block"
	"github.com/authfly/website/internal/kit/ui/grid"
	"github.com/authfly/website/internal/kit/ui/group"
	"github.com/authfly/website/internal/kit/ui/inline"
	"github.com/authfly/website/internal/kit/ui/link"
	"github.com/authfly/website/internal/kit/ui/list"
	"github.com/authfly/website/internal/kit/ui/stack"
	"github.com/authfly/website/internal/kit/ui/text"
	"github.com/authfly/website/internal/kit/ui/title"
	"github.com/authfly/website/internal/ports"
	"github.com/authfly/website/internal/ui/components"
	"github.com/authfly/website/internal/viewmodels"
)

templ Index(m viewmodels.BlogModel) {
	@block.Block(block.BlockProps{Tag: "section", Class: "space-y-10"}) {
		@components.SectionHeader(
			m.Layout.Copy.BlogIndex.Title,
			m.Layout.Copy.BlogIndex.Lead,
		)
		@grid.Grid(grid.GridProps{Class: "gap-4 md:grid-cols-2"}) {
			for _, p := range m.Posts {
				@components.BlogCard(p)
			}
		}
	}
}

templ Post(m viewmodels.BlogPostModel) {
	@block.Block(block.BlockProps{Tag: "article", Class: "mx-auto max-w-3xl space-y-8"}) {
		@block.Block(block.BlockProps{Tag: "header", Class: "space-y-4"}) {
			@link.Link(link.LinkProps{Href: "/blog", Class: "text-sm font-medium text-primary no-underline hover:underline"}) {
				← { m.Layout.Copy.Pages.Blog }
			}
			@group.Group(group.GroupProps{Class: "items-center gap-2 text-sm text-muted-foreground"}) {
				@inline.Inline(inline.InlineProps{Class: "numeric"}) {
					{ viewmodels.FormatDate(m.Post.Date, m.Layout.Lang) }
				}
				@inline.Inline(inline.InlineProps{Class: "opacity-50"}) {
					·
				}
				@inline.Inline(inline.InlineProps{}) {
					{ viewmodels.Itoa(m.Post.ReadMinutes) } { m.Layout.Copy.Common.Minutes }
				}
			}
			@title.Title(title.TitleProps{
				As:    1,
				Class: "font-display text-display-2 font-bold",
			}) {
				{ m.Post.Title }
			}
			@text.Text(text.TextProps{Class: "text-lead text-muted-foreground"}) {
				{ m.Post.Excerpt }
			}
			if len(m.Post.Tags) > 0 {
				@group.Group(group.GroupProps{Class: "flex-wrap gap-2"}) {
					for _, t := range m.Post.Tags {
						@badge.Badge(badge.BadgeProps{Variant: "outline", Size: "sm", Class: "rounded-full px-2 py-0.5"}) {
							{ t }
						}
					}
				}
			}
		}
		@stack.Stack(stack.StackProps{Class: "gap-5"}) {
			if len(m.Post.Blocks) > 0 {
				for _, b := range m.Post.Blocks {
					@BodyBlock(b)
				}
			} else {
				for _, para := range m.Post.Body {
					@text.Text(text.TextProps{Class: "text-base leading-8 text-foreground/90"}) {
						{ para }
					}
				}
			}
		}
	}
}

templ BodyBlock(b ports.BodyBlock) {
	switch b.Kind {
		case "h2":
			@title.Title(title.TitleProps{As: 2, Class: "font-display text-xl font-bold tracking-tight"}) {
				{ b.Text }
			}
		case "h3":
			@title.Title(title.TitleProps{As: 3, Class: "text-lg font-semibold"}) {
				{ b.Text }
			}
		case "ul":
			@list.List(list.ListProps{Tag: "ul", Class: "list-disc space-y-2 pl-5 text-base leading-7 text-foreground/90"}) {
				for _, item := range b.Items {
					@list.ListItem(list.ListItemProps{}) {
						{ item }
					}
				}
			}
		default:
			@text.Text(text.TextProps{Class: "text-base leading-8 text-foreground/90"}) {
				{ b.Text }
			}
	}
}
