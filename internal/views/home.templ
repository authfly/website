package views

import (
	"github.com/authfly/website/internal/ui/blocks/home"
	"github.com/authfly/website/internal/ui/layout"
	"github.com/authfly/website/internal/viewmodels"
)

templ HomePage(m viewmodels.HomeModel) {
	@layout.Store(m.Layout) {
		@home.Hero(m)
		@home.Advantages(m)
		@home.SolutionRail(m, m.Solutions)
		@home.BlogRail(m, m.Posts)
	}
}
