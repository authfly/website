package views

import (
	af "github.com/authfly/authkit/packages/ui/templ/authfly"
	"github.com/authfly/authkit/packages/ui/templ/ui/box"
	"github.com/authfly/authkit/packages/ui/templ/ui/button"
	"github.com/authfly/authkit/packages/ui/templ/ui/disclosure"
	"github.com/authfly/authkit/packages/ui/templ/ui/link"
	"github.com/authfly/authkit/packages/ui/templ/ui/text"
	"strings"
)

// Document is the HTML skeleton: UI8Kit has no primitive for the document root, so this is the one place with
// document tags. Everything inside body is primitives.
templ Document(s Shell) {
	<!DOCTYPE html>
	<html lang={ s.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ s.Title }</title>
			if s.Description != "" {
				<meta name="description" content={ s.Description }/>
				<meta property="og:description" content={ s.Description }/>
			}
			<meta property="og:title" content={ s.Title }/>
			<meta property="og:type" content="website"/>
			<link rel="canonical" href={ s.Canonical }/>
			<link rel="alternate" hreflang={ s.AltLang } href={ s.AltHref }/>
			<link rel="alternate" type="text/markdown" href={ s.MDHref }/>
			<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href={ "/assets/app.css?v=" + Version }/>
			<script src={ "/assets/theme.js?v=" + Version }></script>
		</head>
		<body class="bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

// ThemeToggle: the Button primitive wired by assets/theme.js ([data-ui8kit="theme-toggle"], aria-pressed).
templ ThemeToggle(label string) {
	@button.Button(button.ButtonProps{Type: "button", Class: af.ButtonSkin("ghost", "w-10 px-0"), AriaLabel: label, AriaPressed: "false", Attrs: templ.Attributes{"data-ui8kit": "theme-toggle", "data-testid": "theme-toggle"}}) {
		@text.Text(text.TextProps{Tag: "span", Class: "dark:hidden"}) {
			@af.LucideIcon("moon", "md")
		}
		@text.Text(text.TextProps{Tag: "span", Class: "hidden dark:inline"}) {
			@af.LucideIcon("sun", "md")
		}
	}
}

templ Header(s Shell) {
	@box.Box(box.BoxProps{Tag: "header", Class: "sticky top-0 z-10 w-full bg-card shadow-sm"}) {
		@box.Box(box.BoxProps{Class: "mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-4 px-4"}) {
			@link.Link(link.LinkProps{Href: "/" + s.Lang + "/", Class: "flex items-center gap-2 font-semibold", Attrs: af.A("data-testid", "brand")}) {
				@af.LucideIcon("shield-check", "md")
				@text.Text(text.TextProps{Tag: "span"}) {
					{ s.t("site.name") }
				}
			}
			@af.Group("2", "center", "", "", nil) {
				@link.Link(link.LinkProps{Href: "/" + s.Lang + "/quickstart", Class: af.LinkSkin("hidden text-sm md:inline-flex")}) {
					{ s.t("header.quickstart") }
				}
				@link.Link(link.LinkProps{Href: "/" + s.Lang + "/guides/install-authfly-stalwart", Class: af.LinkSkin("hidden text-sm md:inline-flex")}) {
					{ s.t("header.guides") }
				}
				@link.Link(link.LinkProps{Href: "/llms.txt", Class: af.LinkSkin("hidden text-sm md:inline-flex")}) {
					{ s.t("header.llms") }
				}
				@link.Link(link.LinkProps{Href: s.AltHref, Class: af.ButtonSkin("ghost", "px-2"), AriaLabel: s.t("header.language"), Attrs: af.A("hreflang", s.AltLang, "data-testid", "lang")}) {
					@af.LucideIcon("languages", "sm")
					@text.Text(text.TextProps{Tag: "span"}) {
						{ strings.ToUpper(s.AltLang) }
					}
				}
				@link.Link(link.LinkProps{Href: s.t("link.github"), External: true, Class: af.ButtonSkin("ghost", "w-10 px-0"), AriaLabel: s.t("header.github")}) {
					@af.LucideIcon("code-xml", "md")
				}
				@ThemeToggle(s.t("header.theme"))
			}
		}
	}
}

templ SideNav(s Shell) {
	@af.Stack("6", "", "", "", nil) {
		for _, g := range s.Nav {
			@af.Stack("2", "", "", "", nil) {
				@text.Text(text.TextProps{Tag: "p", Class: "text-xs font-semibold text-muted-foreground"}) {
					{ g.Label }
				}
				@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-2"}) {
					for _, l := range g.Links {
						@box.Box(box.BoxProps{Tag: "li"}) {
							if l.Current {
								@link.Link(link.LinkProps{Href: l.Href, AriaCurrent: "page", Class: "block rounded bg-accent px-2 py-2 text-sm font-semibold text-accent-foreground"}) {
									{ l.Title }
								}
							} else {
								@link.Link(link.LinkProps{Href: l.Href, Class: "block rounded px-2 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"}) {
									{ l.Title }
								}
							}
						}
					}
				}
			}
		}
	}
}

templ Toc(s Shell) {
	if len(s.Toc) > 0 {
		@af.Stack("2", "", "", "", nil) {
			@text.Text(text.TextProps{Tag: "p", Class: "text-xs font-semibold text-muted-foreground"}) {
				{ s.t("page.toc") }
			}
			@box.Box(box.BoxProps{Tag: "ul", Class: "flex flex-col gap-2"}) {
				for _, it := range s.Toc {
					@box.Box(box.BoxProps{Tag: "li", Class: tocCls(it.Sub)}) {
						@link.Link(link.LinkProps{Href: "#" + it.ID, Class: "text-sm text-muted-foreground hover:text-foreground"}) {
							{ it.Title }
						}
					}
				}
			}
		}
	}
}

func tocCls(sub bool) string {
	if sub {
		return "pl-4"
	}
	return ""
}

templ Footer(s Shell) {
	@box.Box(box.BoxProps{Tag: "footer", Class: "w-full bg-card"}) {
		@box.Box(box.BoxProps{Class: "mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:justify-between"}) {
			@text.Text(text.TextProps{Tag: "p", Class: "text-sm text-muted-foreground"}) {
				{ s.t("footer.copyright") }
			}
			@af.Group("4", "center", "", "flex-wrap", nil) {
				@link.Link(link.LinkProps{Href: "/" + s.Lang + "/legal", Class: af.LinkSkin("text-sm")}) {
					{ s.t("footer.legal") }
				}
				@link.Link(link.LinkProps{Href: "/" + s.Lang + "/releases", Class: af.LinkSkin("text-sm")}) {
					{ s.t("footer.releases") }
				}
				@link.Link(link.LinkProps{Href: s.t("link.github"), External: true, Class: af.LinkSkin("text-sm")}) {
					{ s.t("footer.github") }
				}
				@link.Link(link.LinkProps{Href: "/llms-full.txt", Class: af.LinkSkin("text-sm")}) {
					{ s.t("footer.llms") }
				}
			}
		}
	}
}

// Frame is the docs layout: header, sidebar navigation (a disclosure on small screens), article, in-page contents.
templ Frame(s Shell) {
	@Document(s) {
		@link.Link(link.LinkProps{Href: "#content", Class: "sr-only focus:not-sr-only"}) {
			{ s.t("page.skip") }
		}
		@Header(s)
		@box.Box(box.BoxProps{Class: "mx-auto grid w-full max-w-7xl gap-8 px-4 py-8 lg:grid-cols-12"}) {
			@box.Box(box.BoxProps{Tag: "aside", Class: "lg:col-span-3", Attrs: af.A("aria-label", s.t("page.nav"))}) {
				@disclosure.Disclosure(disclosure.DisclosureProps{Class: "lg:hidden"}) {
					@disclosure.Summary(disclosure.SummaryProps{Class: af.ButtonSkin("outline", "w-full justify-start")}) {
						@af.LucideIcon("menu", "sm")
						@text.Text(text.TextProps{Tag: "span"}) {
							{ s.t("page.menu") }
						}
					}
					@box.Box(box.BoxProps{Tag: "nav", Class: "pt-4", Attrs: af.A("aria-label", s.t("page.menu"))}) {
						@SideNav(s)
					}
				}
				@box.Box(box.BoxProps{Tag: "nav", Class: "sticky top-24 hidden lg:block", Attrs: af.A("aria-label", s.t("page.nav"))}) {
					@SideNav(s)
				}
			}
			@box.Box(box.BoxProps{Tag: "main", Class: "min-w-0 lg:col-span-7", Attrs: af.A("id", "content")}) {
				{ children... }
				@af.Stack("4", "", "", "pt-8", nil) {
					@af.Group("4", "center", "between", "flex-wrap", nil) {
						if s.Prev != nil {
							@link.Link(link.LinkProps{Href: s.Prev.Href, Class: af.ButtonSkin("outline"), Attrs: af.A("rel", "prev")}) {
								@af.LucideIcon("arrow-left", "sm")
								@text.Text(text.TextProps{Tag: "span"}) {
									{ s.Prev.Title }
								}
							}
						}
						if s.Next != nil {
							@link.Link(link.LinkProps{Href: s.Next.Href, Class: af.ButtonSkin("outline", "ml-auto"), Attrs: af.A("rel", "next")}) {
								@text.Text(text.TextProps{Tag: "span"}) {
									{ s.Next.Title }
								}
								@af.LucideIcon("arrow-right", "sm")
							}
						}
					}
					@af.Group("4", "center", "", "flex-wrap", nil) {
						@link.Link(link.LinkProps{Href: s.MDHref, Class: af.LinkSkin("text-sm text-muted-foreground"), Attrs: af.A("type", "text/markdown")}) {
							@af.LucideIcon("file-text", "sm")
							@text.Text(text.TextProps{Tag: "span"}) {
								{ s.t("page.markdown") }
							}
						}
						@link.Link(link.LinkProps{Href: s.SourceHref, External: true, Class: af.LinkSkin("text-sm text-muted-foreground")}) {
							@af.LucideIcon("file-pen", "sm")
							@text.Text(text.TextProps{Tag: "span"}) {
								{ s.t("page.edit") }
							}
						}
					}
				}
			}
			@box.Box(box.BoxProps{Tag: "aside", Class: "hidden lg:col-span-2 lg:block", Attrs: af.A("aria-label", s.t("page.toc"))}) {
				@box.Box(box.BoxProps{Class: "sticky top-24"}) {
					@Toc(s)
				}
			}
		}
		@Footer(s)
	}
}
